   "text": "-> functionCall  trending({ \"mode\": \"new\" })\n<- result        [{ \"name\": \"Peel Of\", \"new\": \"opening\",\n                    \"halal\": \"not confirmed\", \"trending_score\": 100 }, ...]\n-> answer        \"Peel Of (Blok M Hub) - banana cake, open kitchen\n                  (halal not confirmed) ...\"",
